# Copy to .env and adjust. Every variable is optional; the values below are the defaults.
# Keep comments on their own lines: both make and docker compose read this file.
# docker compose overrides host addresses (kafka:29092, clickhouse:9000) itself.

# --- logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# --- metrics (/metrics, /healthz) ---
INGESTER_METRICS_ADDR=:9101
WRITER_METRICS_ADDR=:9102

# --- ingester ---
# Instance name in logs and gap events (defaults to the hostname).
# docker compose sets ingester-a / ingester-b.
# INGESTER_ID=
# stdout | kafka
PUBLISHER=stdout

# --- exchanges ---
# Feeds to run. For each name: <NAME>_WS_URL, <NAME>_SYMBOLS, <NAME>_READ_TIMEOUT.
# <NAME>_SYMBOLS are always streamed (pinned); more markets can be added from
# the web UI at runtime without restarting anything.
# Symbols are canonical BASE-QUOTE; adapters translate them (BTCUSDT, BTC/USD).
# READ_TIMEOUT: no frame (incl. heartbeat) for this long => reconnect.
EXCHANGES=coinbase,binance,kraken

COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
COINBASE_SYMBOLS=BTC-USD,ETH-USD
COINBASE_READ_TIMEOUT=15s

# Binance has no heartbeat and stays silent for unknown symbols.
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_SYMBOLS=BTC-USDT,ETH-USDT
BINANCE_READ_TIMEOUT=30s

KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_SYMBOLS=BTC-USD,ETH-USD
KRAKEN_READ_TIMEOUT=15s

# --- websocket connection (all feeds) ---
WS_DIAL_TIMEOUT=10s
# 32 MiB; order book snapshots are large.
WS_READ_LIMIT_BYTES=33554432

RECONNECT_BACKOFF_MIN=500ms
RECONNECT_BACKOFF_MAX=30s
# A session alive this long resets the backoff.
RECONNECT_STABLE_AFTER=1m

# --- kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_TRADES=md.trades
KAFKA_TOPIC_GAPS=md.gaps
KAFKA_TOPIC_CANDLES=md.candles
KAFKA_TOPIC_ALERTS=md.alerts
KAFKA_TOPIC_ALERT_RULES=md.alert-rules
# Compacted: the streamed markets. Ingesters pin their configured symbols
# here and follow it; the UI adds/removes the rest at runtime.
KAFKA_TOPIC_SUBSCRIPTIONS=md.subscriptions
# Compacted: per-market alert settings (whale thresholds), edited in the UI.
KAFKA_TOPIC_SETTINGS=md.settings

# --- writer ---
WRITER_CONSUMER_GROUP=clickhouse-writer
WRITER_BATCH_SIZE=10000
WRITER_FLUSH_INTERVAL=1s
# One insert attempt; a dead connection fails fast and is retried.
WRITER_INSERT_TIMEOUT=10s
# Recent trade IDs remembered per exchange:symbol to drop copies from
# redundant ingesters.
WRITER_DEDUP_WINDOW=20000
WRITER_RETRY_MIN=500ms
WRITER_RETRY_MAX=30s

# --- aggregator (candles) ---
AGGREGATOR_METRICS_ADDR=:9103
AGG_CONSUMER_GROUP=candles-aggregator
# Whole seconds dividing 24h, e.g. 1s,5s,1m,5m,1h.
AGG_INTERVALS=1s,1m
# A candle closes once a trade this far past its end arrives (event time).
AGG_LATENESS=2s
# ...or after this long without trades for the symbol (wall time).
AGG_IDLE=5s
AGG_COMMIT_INTERVAL=1s
AGG_DEDUP_WINDOW=20000
# Latest records per partition of md.candles read on start to learn what
# was already published.
AGG_TAIL_RECORDS=5000

# --- websocket gateway ---
GATEWAY_ADDR=:8090
# Metrics, /healthz, /readyz (fails when Kafka is silent > 30s), /debug/pprof.
GATEWAY_METRICS_ADDR=:9104
GATEWAY_MAX_CONNS=100000
GATEWAY_MAX_SUBSCRIPTIONS=200
# Max messages queued per client before it is disconnected as too slow.
# Memory follows the actual backlog and messages are shared, so a high
# limit is cheap (24 bytes per queued message).
GATEWAY_SEND_QUEUE=1024
GATEWAY_WRITE_TIMEOUT=5s
GATEWAY_PING_INTERVAL=30s
GATEWAY_DEDUP_WINDOW=20000

# --- alerts ---
# Rules API (POST/GET/DELETE /v1/rules).
ALERTS_ADDR=:8091
ALERTS_METRICS_ADDR=:9105
ALERTS_CONSUMER_GROUP=alerts
# Whale thresholds (default and per market) are set in the web UI
# (Settings), stored in KAFKA_TOPIC_SETTINGS.
# Sharp move: at least this % within the window; 0 disables.
ALERT_MOVE_PCT=0.5
ALERT_MOVE_WINDOW=1m
# One alert per symbol and direction per cooldown.
ALERT_MOVE_COOLDOWN=5m
ALERT_MAX_RULES=1000000
ALERT_DEDUP_WINDOW=20000
ALERT_COMMIT_INTERVAL=1s

# --- api (web UI + history; http://localhost:8088) ---
API_ADDR=:8088
API_METRICS_ADDR=:9106
API_GATEWAY_URL=http://localhost:8090
API_ALERTS_URL=http://localhost:8091
# Markets that can be added from the UI (configured/pinned ones don't count).
API_MAX_SUBSCRIPTIONS=40
# Exchange instrument lists are fetched from their REST APIs and cached.
API_CATALOG_TTL=1h

# --- clickhouse ---
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=marketdata
CLICKHOUSE_USER=marketdata
CLICKHOUSE_PASSWORD=marketdata
